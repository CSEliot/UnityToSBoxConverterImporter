; FBX 7.4.0 project file
; unityimporterplus fixture: one static mesh, one material slot, no skeleton, no textures.
; Units are centimetres (UnitScaleFactor 2.54), so the generated model needs the same import scale
; as a real FBX and the fixture exercises the normal model path rather than a special case.

FBXHeaderExtension:  {
	FBXHeaderVersion: 1003
	FBXVersion: 7400
	Creator: "unityimporterplus prefab-free scene fixture"
}
GlobalSettings:  {
	Version: 1000
	Properties70:  {
		P: "UpAxis", "int", "Integer", "",1
		P: "UpAxisSign", "int", "Integer", "",1
		P: "FrontAxis", "int", "Integer", "",2
		P: "FrontAxisSign", "int", "Integer", "",1
		P: "CoordAxis", "int", "Integer", "",0
		P: "CoordAxisSign", "int", "Integer", "",1
		P: "UnitScaleFactor", "double", "Number", "",2.54
	}
}
Definitions:  {
	Version: 100
	Count: 5
}
Objects:  {
	Geometry: 1000, "Geometry::UnresolvedMesh", "Mesh" {
		Vertices: *24 {
			a: -50,-50,0,50,-50,0,50,50,0,-50,50,0,-50,-50,100,50,-50,100,50,50,100,-50,50,100
		}
		PolygonVertexIndex: *24 {
			a: 0,1,-3,0,2,-4,4,6,-8,4,7,-5,0,4,-5,1,5,-2
		}
	}
	Model: 100, "Model::Scene", "Null" {
		Version: 232
	}
	Model: 2000, "Model::UnresolvedMesh", "Mesh" {
		Version: 232
		Properties70:  {
			P: "Lcl Translation", "Lcl Translation", "", "A",0,0,0
			P: "Lcl Rotation", "Lcl Rotation", "", "A",0,0,0
			P: "Lcl Scaling", "Lcl Scaling", "", "A",1,1,1
		}
		Shading: T
		Culling: "CullingOff"
	}
	Material: 3000, "Material::Glass", "" {
		Version: 102
		ShadingModel: "phong"
		MultiLayer: 0
		Properties70:  {
			P: "DiffuseColor", "Color", "", "A",0.8,0.8,0.8
			P: "SpecularColor", "Color", "", "A",0.2,0.2,0.2
			P: "Shininess", "double", "Number", "",20
		}
	}
}
Connections:  {
	; Model::UnresolvedMesh under Model::Scene
	C: "OO",2000,100
	; Geometry::UnresolvedMesh on Model::UnresolvedMesh
	C: "OO",1000,2000
	; Material::Glass on Model::UnresolvedMesh
	C: "OO",3000,2000
}